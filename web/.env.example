# Saypost web. Copy to web/.env.local for `npm run dev`. On Netlify or Vercel, set these in the site's settings.
# All four are public: Next.js inlines NEXT_PUBLIC_* into the browser bundle at build time, so changing them
# needs a rebuild. Never put secrets here (no service role key, no Zernio or Claude keys).

# Supabase: Project Settings → API (the project URL and the anon / publishable key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public URL of the backend (the browser calls it directly).
NEXT_PUBLIC_API_URL=http://localhost:4100
# Public URL of this site (metadata and links).
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Public GitHub repository ("owner/name") for the landing links and star count.
NEXT_PUBLIC_GITHUB_REPO=Martinez03/saypost
