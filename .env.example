# Saypost with Docker Compose: copy to .env next to docker-compose.yml and fill it in. Never commit .env.
# The backend reads every variable here; the web only gets the public ones as build args.
# Step by step: docs/SELF_HOSTING.md

# --- Public URLs -----------------------------------------------------------------------------------------
# With the bundled Caddy (`docker compose --profile caddy up -d`): point DOMAIN's DNS at this server and set
# WEB_URL and API_URL to https://<DOMAIN>. Caddy serves the web and the backend on that one domain
# (/api/*, /webhooks/* and /health go to the backend) and gets the certificate automatically.
DOMAIN=
# Where people open the dashboard. Also the backend's allowed CORS origin.
WEB_URL=http://localhost:3100
# Where the browser and Zernio reach the backend (the webhook is $API_URL/webhooks/zernio).
API_URL=http://localhost:4100
# Extra CORS origins, comma-separated; `*` matches inside one host label (https://*--my-saypost.netlify.app).
WEB_ORIGINS=

# --- Supabase (Project Settings → API) ------------------------------------------------------------------
SUPABASE_URL=
# Public: goes into the web bundle.
SUPABASE_ANON_KEY=
# Secret: bypasses RLS. Backend only.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ------------------------------------------------------------------------------------------------
# Claude: the WhatsApp agent and the reply drafts.
ANTHROPIC_API_KEY=
# OpenAI: only to transcribe voice notes (optional; without it Saypost asks the owner to type instead).
OPENAI_API_KEY=

# --- Zernio (https://zernio.com) -------------------------------------------------------------------------
ZERNIO_API_KEY=
# Any long random string, e.g. node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Register it with: node scripts/setup-zernio-webhook.mjs --env-file .env
ZERNIO_WEBHOOK_SECRET=

# --- Optional -------------------------------------------------------------------------------------------
# CLAUDE_MODEL=claude-opus-5-5
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# REVIEW_POLL_SECONDS=120
# Host ports for the backend and the web when you run your own reverse proxy (bound to 127.0.0.1).
# BACKEND_PORT=4100
# WEB_PORT=3100
