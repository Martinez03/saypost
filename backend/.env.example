# Dilo backend. Copy to backend/.env.local for `npm run dev` (or use the root .env with Docker Compose).
# Never commit the real file. Details: docs/SELF_HOSTING.md

NODE_ENV=development
PORT=4100

# Public URL of the web dashboard. Used for CORS and as the return URL after connecting a social account.
WEB_URL=http://localhost:3100
# Extra allowed CORS origins, comma-separated. `*` matches letters, digits and dashes inside one host label,
# e.g. https://*--my-dilo.netlify.app for Netlify deploy previews.
WEB_ORIGINS=

# Supabase: Project Settings → API. The service role key bypasses RLS: backend only, never in the web.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude (https://console.anthropic.com): the WhatsApp agent and the reply drafts.
ANTHROPIC_API_KEY=
# OpenAI (https://platform.openai.com): only to transcribe voice notes. Without it, voice notes get a polite "please type it".
OPENAI_API_KEY=

# Zernio (https://zernio.com): API key from the dashboard. The webhook secret is any long random string you
# choose; scripts/setup-zernio-webhook.mjs registers it in Zernio together with the webhook URL.
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=

# Optional
# CLAUDE_MODEL=claude-opus-5-5
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Poll Facebook reviews (they have no webhook) every N seconds; 0 disables it.
# REVIEW_POLL_SECONDS=120
# ZERNIO_API_BASE=https://zernio.com/api/v1
